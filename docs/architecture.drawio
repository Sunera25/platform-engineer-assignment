        <!-- ═══════════════════════════════════════════
             TRAFFIC FLOW ARROWS
             ═══════════════════════════════════════════ -->

        <!-- 1. Internet → IGW (user traffic in) -->
        <mxCell id="100" value=""
          style="edgeStyle=orthogonalEdgeStyle;html=1;
